---
import { getImage } from "astro:assets";
import Background from "../assets/careers/bg.jpg"

const optimizedBackground = await getImage({src: Background, format: 'avif'})
---


<section class="py-10 sm:py-13 lg:py-14 bg-white relative" style={`background-image: url(${optimizedBackground.src}); background-size: cover; background-repeat: no-repeat; background-position: center;`}>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col justify-center items-center reveal">
         <!-- Glass Content Box -->
        <div class="relative z-10 max-w-4xl mx-auto px-8 py-10 text-center 
                    bg-white/10 backdrop-blur-md rounded-2xl">

            <h2 class="text-2xl md:text-3xl lg:text-4xl font-semibold leading-tight text-white mb-3">
            Delivering the future of global trade.
            </h2>

            <p class="text-lg md:text-xl font-semibold text-gray-200 mb-2">
            Alone we go Fast, Together we go Far !
            </p>

            <p class="text-sm md:text-base leading-5.5 md:leading-6 text-gray-200 mb-6">
            If you have the passion and zeal to outperform yourself in 
            the field of International Logistics and are looking for the 
            right platform, don't look any further. Reach out to us...
            </p>

            <button class="bg-primary text-white text-sm md:text-base px-4 md:px-8 py-3 rounded-full font-medium hover:bg-secondary transition-colors duration-300 ease-in-out">
                Enroll Now
            </button>

        </div>
    </div>
</section>