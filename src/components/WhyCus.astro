---
import { Image } from 'astro:assets';
import Whycus from "../assets/whycus/wcus.jpg";
import Container from "../assets/whycus/container.png";
---


<section class="py-10 sm:py-13 lg:py-14 bg-white">
        <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative">
            <h2 class="font-bold text-primary uppercase border-l-2 border-primary pl-4 mb-8 md:mb-12">Why Us</h2>

            <div class="grid grid-cols-1 md:grid-cols-[50%_30%] lg:grid-cols-[50%_25%] gap-10 lg:gap-0 justify-between items-center mb-8 md:mb-10 reveal">
                <div>
                    <h2 class="text-2xl md:text-3xl lg:text-4xl font-semibold text-blue-900 mb-8 md:mb-12 leading-tight">Adapting to change is key to progress.</h2>
                    <a href="#" class="mt-3 bg-primary text-white text-sm md:text-base px-4 md:px-8 py-3 rounded-full font-medium hover:bg-secondary transition-colors duration-300 ease-in-out">
                        Let's Discuss Today
                    </a>
                </div>
                <div>
                    <Image src={Whycus} alt="Why Us" class="w-full h-full object-cover"></Image>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 border border-gray-200 divide-y md:divide-y-0 md:divide-x divide-gray-200 bg-white reveal z-10 relative">
      
                <!-- Card 1 -->
                <div class="p-10 md:p-6 lg:p-10 text-left">
                <div class="mb-3 text-[#7EA2FF]">
                    <!-- Shield Icon -->
                    <svg xmlns="http://www.w3.org/2000/svg"
                        class="w-9 h-9"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="1.5">

                    <path stroke-linecap="round" stroke-linejoin="round"
                            d="M3 7l9-4 9 4-9 4-9-4z" />
                    <path stroke-linecap="round" stroke-linejoin="round"
                            d="M3 7v10l9 4 9-4V7" />
                    <path stroke-linecap="round" stroke-linejoin="round"
                            d="M12 11v10" />

                    </svg>
                </div>

                <h3 class="text-lg font-semibold text-primary mb-1">
                    Global Freight Expertise
                </h3>

                <p class="text-sm leading-5.5 md:leading-6">
                    Seamless shipping solutions across regions, backed by industry know-how.
                </p>
                </div>

                <!-- Card 2 -->
                <div class="p-10 md:p-6 lg:p-10 text-left">
                <div class="mb-3 text-[#7EA2FF]">
                    <!-- Cube Icon -->
                    <svg xmlns="http://www.w3.org/2000/svg"
                        class="w-9 h-9"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="1.5">

                    <!-- Clock Circle -->
                    <circle cx="13" cy="12" r="8" />

                    <!-- Clock Hands -->
                    <path stroke-linecap="round" stroke-linejoin="round"
                            d="M13 8v4l3 2" />

                    <!-- Speed Lines -->
                    <path stroke-linecap="round"
                            d="M2 12h4M2 16h6M2 8h3" />

                    </svg>
                </div>

                <h3 class="text-lg font-semibold text-primary mb-1">
                    Optimized Transit Times
                </h3>

                <p class="text-sm leading-5.5 md:leading-6">
                    We cut delivery time through smart routes and fast handling.
                </p>
                </div>

                <!-- Card 3 -->
                <div class="p-10 md:p-6 lg:p-10 text-left">
                <div class="mb-3 text-[#7EA2FF]">
                    <!-- Globe Icon -->
                    <svg xmlns="http://www.w3.org/2000/svg"
                        class="w-9 h-9"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="1.5">

                    <!-- Headband -->
                    <path stroke-linecap="round" stroke-linejoin="round"
                            d="M4 13a8 8 0 0116 0" />

                    <!-- Ear Pads -->
                    <rect x="3" y="13" width="4" height="6" rx="2" />
                    <rect x="17" y="13" width="4" height="6" rx="2" />

                    <!-- Mic -->
                    <path stroke-linecap="round" stroke-linejoin="round"
                            d="M17 19a3 3 0 01-3 3h-2" />

                    </svg>
                </div>

                <h3 class="text-lg font-semibold text-primary mb-1">
                    24/7 Dedicated Support
                </h3>

                <p class="text-sm leading-5.5 md:leading-6">
                    Real-time updates and expert support — whenever you need.
                </p>
                </div>

            </div>

            <div class="relative">
                <Image src={Container} alt="Container" class="swing-container w-2/3 md:w-1/2 h-auto m-auto -mt-1.25 z-0 reveal"></Image>
                <div class="text-center mt-12">
                    <a href="#" class="bg-primary text-white text-sm md:text-base px-4 md:px-8 py-3 rounded-full font-medium hover:bg-secondary transition-colors duration-300 ease-in-out">
                        Request A Quote
                    </a>
                </div>
            </div>

        </div>
</section>


<style>
.swing-container {
  transform-origin: top center; /* VERY IMPORTANT */
  animation: swing 4s ease-in-out infinite;
}

/* Swing animation */
@keyframes swing {
  0% {
    transform: rotate(0deg);
  }
  25% {
    transform: rotate(-6deg);
  }
  50% {
    transform: rotate(0deg);
  }
  75% {
    transform: rotate(6deg);
  }
  100% {
    transform: rotate(0deg);
  }
}
</style>