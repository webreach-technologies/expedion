---
---

<section class="pt-20 sm:pt-32 lg:pt-28 bg-white">
        <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative">
            <h2 class="font-bold text-primary uppercase border-l-2 border-primary pl-4 mb-8 md:mb-12">FAQs</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-7 md:gap-10 reveal">

                    <!-- LEFT SIDE -->
                    <div class="flex flex-col justify-between">
                    <h2 class="text-2xl md:text-3xl lg:text-4xl font-semibold text-blue-900 leading-tight mb-6">
                        Any doubts?<br />
                        We’re here to help
                    </h2>

                    <div>
                        <p class="text-sm md:text-lg font-semibold text-gray-900">
                        Can't find what you're looking for?
                        </p>
                        <p class="text-sm md:text-lg font-semibold text-gray-900">
                        Contact us here:
                        </p>
                        <a href="mailto:hello@bogixglobal.com" class="text-sm md:text-lg font-bold">
                        hello@bogixglobal.com
                        </a>
                    </div>
                    </div>

                    <!-- RIGHT SIDE FAQ -->
                    <div class="space-y-5">

                        <!-- FAQ Item -->
                        <div class="faq-item border-b border-gray-300 pb-4">
                        <button class="faq-question flex justify-between items-center w-full text-left text-lg md:text-xl font-semibold text-black">
                        How long does shipping usually take?
                        <span class="arrow transition-transform duration-300"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down-icon lucide-chevron-down"><path d="m6 9 6 6 6-6"/></svg></span>
                        </button>
                        <div class="faq-answer overflow-hidden max-h-0 transition-all duration-500 ease-in-out">
                        <p class="mt-3 text-gray-600 leading-5.5 md:leading-6">
                        Shipping typically takes 5–7 business days, depending on the destination and chosen service tier.
                        </p>
                        </div>
                        </div>

                        <!-- FAQ Item -->
                        <div class="faq-item border-b border-gray-300 pb-4">
                        <button class="faq-question flex justify-between items-center w-full text-left text-lg md:text-xl font-semibold text-black">
                        What regions do you operate in?
                        <span class="arrow transition-transform duration-300"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down-icon lucide-chevron-down"><path d="m6 9 6 6 6-6"/></svg></span>
                        </button>
                        <div class="faq-answer overflow-hidden max-h-0 transition-all duration-500 ease-in-out">
                        <p class="mt-3 text-gray-600 leading-5.5 md:leading-6">
                        We operate across major global trade routes including Asia, Europe, North America, and the Middle East.
                        </p>
                        </div>
                        </div>

                        <!-- FAQ Item -->
                        <div class="faq-item border-b border-gray-300 pb-4">
                        <button class="faq-question flex justify-between items-center w-full text-left text-lg md:text-xl font-semibold text-black">
                        Can I track my shipments in real-time?
                        <span class="arrow transition-transform duration-300"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down-icon lucide-chevron-down"><path d="m6 9 6 6 6-6"/></svg></span>
                        </button>
                        <div class="faq-answer overflow-hidden max-h-0 transition-all duration-500 ease-in-out">
                        <p class="mt-3 text-gray-600 leading-5.5 md:leading-6">
                        Yes, we provide real-time tracking through our logistics dashboard.
                        </p>
                        </div>
                        </div>

                        <!-- FAQ Item -->
                        <div class="faq-item border-b border-gray-300 pb-4">
                        <button class="faq-question flex justify-between items-center w-full text-left text-lg md:text-xl font-semibold text-black">
                        What are your customer support hours?
                        <span class="arrow transition-transform duration-300"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down-icon lucide-chevron-down"><path d="m6 9 6 6 6-6"/></svg></span>
                        </button>
                        <div class="faq-answer overflow-hidden max-h-0 transition-all duration-500 ease-in-out">
                        <p class="mt-3 text-gray-600 leading-5.5 md:leading-6">
                        Our support team is available Monday–Friday, 9 AM–6 PM.
                        </p>
                        </div>
                        </div>

                        <!-- FAQ Item -->
                        <div class="faq-item border-b border-gray-300 pb-4">
                        <button class="faq-question flex justify-between items-center w-full text-left text-lg md:text-xl font-semibold text-black">
                        Do you handle fragile or high-value cargo?
                        <span class="arrow transition-transform duration-300"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down-icon lucide-chevron-down"><path d="m6 9 6 6 6-6"/></svg></span>
                        </button>
                        <div class="faq-answer overflow-hidden max-h-0 transition-all duration-500 ease-in-out">
                        <p class="mt-3 text-gray-600 leading-5.5 md:leading-6">
                        Absolutely. We use specialized packaging and secure transport solutions.
                        </p>
                        </div>
                        </div>

                    </div>         

            </div>

        </div>
</section>


<script>
  const faqItems = document.querySelectorAll('.faq-item');

  // Open first by default
  window.addEventListener('load', () => {
    const firstItem = faqItems[0];
    const firstAnswer = firstItem.querySelector('.faq-answer');
    const firstArrow = firstItem.querySelector('.arrow');

    firstAnswer.style.maxHeight = firstAnswer.scrollHeight + "px";
    firstArrow.classList.add('rotate-180');
  });

  faqItems.forEach(item => {
    const btn = item.querySelector('.faq-question');
    const answer = item.querySelector('.faq-answer');
    const arrow = item.querySelector('.arrow');

    btn.addEventListener('click', () => {
      const isOpen = answer.style.maxHeight && answer.style.maxHeight !== "0px";

      // Close ALL first
      faqItems.forEach(i => {
        i.querySelector('.faq-answer').style.maxHeight = null;
        i.querySelector('.arrow').classList.remove('rotate-180');
      });

      // If clicked item was closed → open it
      if (!isOpen) {
        answer.style.maxHeight = answer.scrollHeight + "px";
        arrow.classList.add('rotate-180');
      }
    });
  });
</script>