<style>
    /* Custom animations */
        .dropdown-menu {
            opacity: 0;
            visibility: hidden;
            transform: translateY(-10px);
            transition: all 0.3s ease;
        }
        
        .dropdown-menu.active {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        /* Hamburger animation */
        .hamburger span {
            transition: all 0.3s ease;
        }
        
        .hamburger.active span:nth-child(1) {
            transform: rotate(45deg) translate(5px, 5px);
        }
        
        .hamburger.active span:nth-child(2) {
            opacity: 0;
            transform: translateX(-20px);
        }
        
        .hamburger.active span:nth-child(3) {
            transform: rotate(-45deg) translate(7px, -6px);
        }

        /* Mobile menu animation */
        .mobile-menu {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.5s ease;
        }
        
        .mobile-menu.active {
            max-height: 1000px;
        }

        /* Mobile dropdown animation */
        .mobile-dropdown {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.3s ease;
        }
        
        .mobile-dropdown.active {
            max-height: 500px;
        }

        /* Chevron rotation */
        .chevron {
            transition: transform 0.3s ease;
        }
        
        .chevron.active {
            transform: rotate(180deg);
        }

        /* Nested dropdown for desktop */
        .nested-dropdown {
            opacity: 0;
            visibility: hidden;
            transform: translateX(-10px);
            transition: all 0.3s ease;
        }
        
        .nested-dropdown.active {
            opacity: 1;
            visibility: visible;
            transform: translateX(0);
        }
</style>

<script>
   // DOM Elements
        const hamburger = document.getElementById('hamburger');
        const mobileMenu = document.getElementById('mobile-menu');
        const dropdowns = document.querySelectorAll('[data-dropdown]');
        const nestedDropdowns = document.querySelectorAll('[data-nested-dropdown]');
        const mobileDropdownContainers = document.querySelectorAll('.mobile-dropdown-container');
        const mobileLinks = document.querySelectorAll('.mobile-link');

        // Check if device is desktop
        const isDesktop = () => window.innerWidth >= 1024;

        // Toggle mobile menu
        hamburger.addEventListener('click', () => {
            hamburger.classList.toggle('active');
            mobileMenu.classList.toggle('active');
        });

        // Close mobile menu when clicking a link
        mobileLinks.forEach(link => {
            link.addEventListener('click', () => {
                hamburger.classList.remove('active');
                mobileMenu.classList.remove('active');
                // Close all mobile dropdowns
                mobileDropdownContainers.forEach(container => {
                    container.querySelector('.mobile-dropdown').classList.remove('active');
                    container.querySelector('.chevron').classList.remove('active');
                });
            });
        });

        // Desktop dropdowns - HOVER functionality
        dropdowns.forEach(dropdown => {
            const menu = dropdown.querySelector('.dropdown-menu');
            const chevron = dropdown.querySelector('.chevron');
            let timeoutId;

            // Mouse enter - open dropdown
            dropdown.addEventListener('mouseenter', () => {
                if (!isDesktop()) return;
                clearTimeout(timeoutId);
                
                // Close other dropdowns
                dropdowns.forEach(other => {
                    if (other !== dropdown) {
                        other.querySelector('.dropdown-menu').classList.remove('active');
                        other.querySelector('.chevron').classList.remove('active');
                    }
                });

                menu.classList.add('active');
                chevron.classList.add('active');
            });

            // Mouse leave - close dropdown with small delay
            dropdown.addEventListener('mouseleave', () => {
                if (!isDesktop()) return;
                timeoutId = setTimeout(() => {
                    menu.classList.remove('active');
                    chevron.classList.remove('active');
                    // Also close nested dropdowns
                    dropdown.querySelectorAll('.nested-dropdown').forEach(nested => {
                        nested.classList.remove('active');
                    });
                }, 100);
            });

            // Close dropdown when clicking a link inside
            menu.querySelectorAll('a').forEach(link => {
                link.addEventListener('click', () => {
                    menu.classList.remove('active');
                    chevron.classList.remove('active');
                });
            });
        });

        // Desktop nested dropdowns - HOVER functionality
        nestedDropdowns.forEach(nested => {
            const menu = nested.querySelector('.nested-dropdown');
            let nestedTimeoutId;

            // Mouse enter - open nested dropdown
            nested.addEventListener('mouseenter', () => {
                if (!isDesktop()) return;
                clearTimeout(nestedTimeoutId);
                
                // Close other nested dropdowns at same level
                const parent = nested.parentElement;
                parent.querySelectorAll('[data-nested-dropdown]').forEach(other => {
                    if (other !== nested) {
                        other.querySelector('.nested-dropdown').classList.remove('active');
                    }
                });

                menu.classList.add('active');
            });

            // Mouse leave - close nested dropdown with small delay
            nested.addEventListener('mouseleave', () => {
                if (!isDesktop()) return;
                nestedTimeoutId = setTimeout(() => {
                    menu.classList.remove('active');
                }, 100);
            });

            // Close nested dropdown when clicking a link
            menu.querySelectorAll('a').forEach(link => {
                link.addEventListener('click', () => {
                    // Close all dropdowns
                    dropdowns.forEach(dropdown => {
                        dropdown.querySelector('.dropdown-menu').classList.remove('active');
                        dropdown.querySelector('.chevron').classList.remove('active');
                    });
                    nestedDropdowns.forEach(nd => {
                        nd.querySelector('.nested-dropdown').classList.remove('active');
                    });
                });
            });
        });

        // Mobile dropdowns - CLICK functionality
        mobileDropdownContainers.forEach(container => {
            const trigger = container.querySelector('.mobile-dropdown-trigger');
            const menu = container.querySelector('.mobile-dropdown');
            const chevron = container.querySelector('.chevron');

            trigger.addEventListener('click', (e) => {
                e.stopPropagation();

                // Close sibling dropdowns (same level only)
                const parent = container.parentElement;
                const siblings = parent.querySelectorAll(':scope > .mobile-dropdown-container');
                
                siblings.forEach(sibling => {
                    if (sibling !== container) {
                        const siblingMenu = sibling.querySelector(':scope > .mobile-dropdown');
                        const siblingChevron = sibling.querySelector(':scope > .mobile-dropdown-trigger .chevron');
                        if (siblingMenu) siblingMenu.classList.remove('active');
                        if (siblingChevron) siblingChevron.classList.remove('active');
                    }
                });

                menu.classList.toggle('active');
                chevron.classList.toggle('active');
            });
        });

        // Close mobile menu on window resize (if switching to desktop)
        window.addEventListener('resize', () => {
            if (window.innerWidth >= 1024) {
                hamburger.classList.remove('active');
                mobileMenu.classList.remove('active');
                // Reset mobile dropdowns
                mobileDropdownContainers.forEach(container => {
                    container.querySelector('.mobile-dropdown').classList.remove('active');
                    container.querySelector('.chevron').classList.remove('active');
                });
            }
        });
</script>