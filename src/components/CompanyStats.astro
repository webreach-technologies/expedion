---
import { Image } from 'astro:assets';
import Stats1 from "../assets/companystats/cstats-1.jpg";
import Stats2 from "../assets/companystats/cstats-2.jpg";
import Stats3 from "../assets/companystats/cstats-3.jpg";
---

<section id="statsSection" class="pt-8 sm:pt-13 lg:pt-14 pb-10 sm:pb-13 lg:pb-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">

      <div class="grid grid-cols-1 md:grid-cols-3 gap-2 mb-8 md:mb-10 reveal relative">
        <!-- <Image src={Stats3} alt="Years of Experience" class="absolute inset-0 w-full h-full lg:hidden" /> -->

        <!-- Box 1 -->
        <div class="relative h-35 md:h-80 lg:h-120 overflow-hidden">
          <Image src={Stats1} alt="Years of Experience" quality={20} class="absolute inset-0 w-full h-full object-cover" />

          <div class="absolute inset-0 bg-black/50"></div>

          <div class="relative z-10 flex items-center md:items-end h-full p-8">
            <div>
              <h2 class="text-white text-5xl lg:text-7xl font-semibold counter" data-target="20">0+</h2>
              <p class="text-white text-base lg:text-lg mt-2">Years of Experience</p>
            </div>
          </div>
        </div>

        <!-- Box 2 -->
        <div class="relative h-35 md:h-80 lg:h-120 overflow-hidden">
          <Image src={Stats2} alt="Countries Covered" quality={20} class="absolute inset-0 w-full h-full object-cover" />

          <div class="absolute inset-0 bg-black/50"></div>

          <div class="relative z-10 flex items-center justify-center h-full p-8 md:p-0">
            <div class="md:text-center">
              <h2 class="text-white text-5xl lg:text-7xl font-semibold counter" data-target="160">0+</h2>
              <p class="text-white text-base lg:text-lg mt-2">Countries Covered</p>
            </div>
          </div>
        </div>

        <!-- Box 3 -->
        <div class="relative h-35 md:h-80 lg:h-120 overflow-hidden">
          <Image src={Stats3} alt="Delivered Packages" quality={20} class="absolute inset-0 w-full h-full object-cover" />

          <div class="absolute inset-0 bg-black/50"></div>

          <div class="relative z-10 flex items-center md:items-start justify-end h-full p-8">
            <div class="md:text-right">
              <h2 class="text-white text-5xl lg:text-7xl font-semibold counter" data-target="20000" data-suffix="K+">0</h2>
              <p class="text-white text-base lg:text-lg mt-2">Delivered Packages</p>
            </div>
          </div>
        </div>

      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 border border-gray-200 divide-y md:divide-y-0 md:divide-x divide-gray-200 bg-white reveal">
      
        <!-- Card 1 -->
        <div class="p-5 md:p-6 lg:p-10 text-left">
          <div class="mb-3 text-[#7EA2FF]">
            <!-- Shield Icon -->
            <svg xmlns="http://www.w3.org/2000/svg" 
                class="w-9 h-9" 
                fill="none" 
                viewBox="0 0 24 24" 
                stroke="currentColor" 
                stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" 
                d="M12 3l7 4v5c0 5-3.5 9-7 9s-7-4-7-9V7l7-4z" />
            </svg>
          </div>

          <h3 class="text-lg font-semibold text-primary mb-1">
            Trusted by Industry Leaders
          </h3>

          <p class="text-sm leading-5.5 md:leading-6">
            We’ve earned the confidence of global brands through consistent, 
            on-time delivery.
          </p>
        </div>

        <!-- Card 2 -->
        <div class="p-5 md:p-6 lg:p-10 text-left">
          <div class="mb-3 text-[#7EA2FF]">
            <!-- Cube Icon -->
            <svg xmlns="http://www.w3.org/2000/svg" 
                class="w-9 h-9" 
                fill="none" 
                viewBox="0 0 24 24" 
                stroke="currentColor" 
                stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" 
                d="M12 3l9 4.5-9 4.5-9-4.5 9-4.5zM3 7.5v9l9 4.5 9-4.5v-9" />
            </svg>
          </div>

          <h3 class="text-lg font-semibold text-primary mb-1">
            Expert Handling & Clearance
          </h3>

          <p class="text-sm leading-5.5 md:leading-6">
            Seamless documentation, customs clearance, and cargo handling 
            from start to finish.
          </p>
        </div>

        <!-- Card 3 -->
        <div class="p-5 md:p-6 lg:p-10 text-left">
          <div class="mb-3 text-[#7EA2FF]">
            <!-- Globe Icon -->
            <svg xmlns="http://www.w3.org/2000/svg" 
                class="w-9 h-9" 
                fill="none" 
                viewBox="0 0 24 24" 
                stroke="currentColor" 
                stroke-width="1.5">
              <circle cx="12" cy="12" r="9" />
              <path stroke-linecap="round" stroke-linejoin="round" 
                d="M3 12h18M12 3c3 3.5 3 14 0 18M12 3c-3 3.5-3 14 0 18" />
            </svg>
          </div>

          <h3 class="text-lg font-semibold text-primary mb-1">
            Digital Logistics Platform
          </h3>

          <p class="text-sm leading-5.5 md:leading-6">
            Manage, track, and optimize your shipments with real-time updates 
            from anywhere.
          </p>
        </div>

      </div>

    </div>
</section>


<script>
  const section = document.getElementById("statsSection");
  const counters = section.querySelectorAll(".counter");

  let started = false;

  const observer = new IntersectionObserver((entries) => {
    if (entries[0].isIntersecting && !started) {
      started = true;

      counters.forEach(counter => {
        const target = +counter.dataset.target;
        const suffix = counter.dataset.suffix || "+";
        const duration = 2000;

        let startTime = null;

        function animate(timestamp) {
          if (!startTime) startTime = timestamp;

          const progress = timestamp - startTime;
          const percentage = Math.min(progress / duration, 1);
          const current = Math.floor(percentage * target);

          if (suffix === "K+") {
            counter.innerText = Math.floor(current / 1000) + "K+";
          } else {
            counter.innerText = current + suffix;
          }

          if (percentage < 1) {
            requestAnimationFrame(animate);
          }
        }

        requestAnimationFrame(animate);
      });

      observer.disconnect();
    }
  }, { threshold: 0.4 });

  observer.observe(section);
</script>
