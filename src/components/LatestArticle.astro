---
import { Image } from 'astro:assets';
import LatestArticle from "../assets/articles/LatestArticle.jpg";
---

<section class="pt-10 sm:pt-13 lg:pt-14 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
            <h2 class="font-bold text-primary uppercase border-l-2 border-primary pl-4 mb-8 md:mb-12">Articles</h2>
            <!-- <h3 class="text-center text-2xl md:text-3xl lg:text-4xl font-semibold mb-8 leading-tight reveal">Latest Articles</h3> -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-7 md:gap-10 reveal">
                <div>
                    <Image src={LatestArticle} alt="Why Us" class="w-full h-full object-cover aspect-10/7 sm:aspect-2/1 md:aspect-2/1"></Image>
                </div>

                <div class="space-y-4 xl:space-y-8">
                    <h3 class="text-blue-900 text-2xl md:text-3xl lg:text-4xl font-semibold mb-5 lg:mb-6 xl:mb-8 leading-tight">Latest Articles</h3>

                    <div class="group cursor-pointer">
                        <h2 class="text-lg md:text-xl font-medium leading-tight transition-all duration-200 text-black">
                            Ocean freight trends to watch in 2025
                        </h2>
